{
  "extends": [
    "@tsconfig/strictest/tsconfig",
    "@tsconfig/node-lts/tsconfig"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["es2023", "WebWorker"],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
  ]
}
